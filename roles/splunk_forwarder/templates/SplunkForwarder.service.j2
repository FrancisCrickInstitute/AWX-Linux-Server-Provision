# This file is managed by Ansible.
# Manual changes will be overwritten.
#
# This unit replaces the service normally generated by:
# splunk enable boot-start -systemd-managed 1

[Unit]
Description=Splunk Universal Forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
ExecStart={{ splunk_forwarder_home }}/bin/splunk _internal_launch_under_systemd
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=360
LimitNOFILE=65536
LimitRTPRIO=99
SuccessExitStatus=51 52
RestartPreventExitStatus=51
RestartForceExitStatus=52
User={{ splunk_forwarder_user }}
Group={{ splunk_forwarder_group }}
NoNewPrivileges=yes
PermissionsStartOnly=true
AmbientCapabilities=CAP_DAC_READ_SEARCH
Delegate=no

[Install]
WantedBy=multi-user.target